{
  "name": "takin",
  "version": "0.1.0",
  "description": "תקין — סורק סיכונים משפטיים אפשריים לאתרים של עסקים קטנים",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
