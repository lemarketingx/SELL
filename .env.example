# Upstash Redis — אחסון דוחות (30 יום) והגבלת שימוש (5 סריקות חינם לשעה לכל IP).
# בפרויקט Vercel הקיים המשתנים האלה נוצרו אוטומטית בחיבור Upstash. נתמכים גם KV_REST_API_URL / KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=

# ערך אקראי לגיבוב כתובות IP במפתחות ההגבלה
RATE_LIMIT_SALT=

# 1 = הדוח המלא דורש תשלום (שלב 4). כל עוד ריק, הדוח המלא פתוח בחינם.
REPORT_PAYWALL_ENABLED=

# ⚠️ לבדיקות בלבד — לא להגדיר בייצור:
# NEXT_PUBLIC_TAKIN_TEST=1 TAKIN_TEST_ALLOW_PRIVATE=1 TAKIN_TEST_MEMORY_STORE=1
